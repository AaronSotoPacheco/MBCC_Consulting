# Copia este archivo a ".env" (junto a docker-compose.yml) y llena los valores. NUNCA lo subas a git.

# Dirección con la que entrarán a la página (sin https://). Dominio público, IP o nombre interno.
SITIO=calidad.tuempresa.com
APP_TIMEZONE=America/Mexico_City

# Contraseñas de MySQL: largas y distintas entre sí
DB_ROOT_PASSWORD=
DB_DATABASE=mbcc
DB_USERNAME=mbcc
DB_PASSWORD=

# Se genera una sola vez (ver DESPLIEGUE.md, paso 3) y NO se cambia después: cifra los tokens de sesión
APP_KEY=

# Comparación con IA en la Estación (opcional; sin clave esa función queda desactivada)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Alerta de rechazos altos: % de NG en las últimas N piezas (mínimo de piezas para evaluar)
NG_UMBRAL=5
NG_VENTANA=20
NG_MUESTRA_MINIMA=10

# Respaldos automáticos: hora diaria (hora de la planta) y cuántos días conservar
HORA_RESPALDO=02:00
RETENCION_DIAS=30

# Registros de errores: nivel (warning, error…) y días que se conservan
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
